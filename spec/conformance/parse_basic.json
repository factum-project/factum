[
  {
    "id": "basic-node",
    "description": "Simplest valid node: id + predicate with 2 args",
    "input": "(node n001 :pred (instance-of @ACME-CORP organization))",
    "expected_canonical": "(node n001 :pred (instance-of @ACME-CORP organization) :valid forever :src (asserted \"system\") :conf 0.6 :auth 0.5 :perm public)"
  },
  {
    "id": "node-with-confidence",
    "description": "Node with confidence and authority",
    "input": "(node n002 :pred (located-in @X @Y) :conf 0.85 :auth 0.9)",
    "expected_canonical": "(node n002 :pred (located-in @X @Y) :valid forever :src (asserted \"system\") :conf 0.85 :auth 0.9 :perm public)"
  },
  {
    "id": "node-with-decimal",
