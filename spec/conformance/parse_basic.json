  },
  {
    "id": "node-with-verbatim-provenance",
    "description": "Verbatim provenance — verifies doc id and span are preserved",
    "input": "(node n005b :pred (quote @X \"hello world\") :src (verbatim \"doc002\" [50 61]))",
    "expected_canonical": "(node n005b :pred (quote @X \"hello world\") :valid forever :src (verbatim \"doc002\" [50 61]) :conf 0.6 :auth 0.5 :perm public)"
  },
  {
